# Copy this file to  .env  (same folder) and fill it in.
# .env is git-ignored and must never be shared. No password is ever stored by
# the scripts: it is bcrypt-hashed locally and only the hash is sent to Sorare.

SORARE_EMAIL=you@example.com
SORARE_PASSWORD=your-sorare-password

# Identifies this app in the JWT. Any short name; keep it stable.
SORARE_JWT_AUD=sorare-portfolio-terminal

# Optional but strongly recommended: free, self-service, from
# https://sorare.com/settings/developer  -> raises 60 to 200 calls/minute.
SORARE_API_KEY=
