# Windows scripts must keep CRLF line endings: cmd.exe misparses multi-line
# if-blocks written with Unix endings, and the console window closes without
# running anything.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Everything else stays as it is.
*.py  text eol=lf
*.graphql text eol=lf
*.sql text eol=lf
*.yml text eol=lf
