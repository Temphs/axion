// Prisma schema for the Axion employee-productivity backend.
// See AGENTS.md: this is Prisma 7 (new `prisma-client` generator + prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// --- Auth (manager accounts) ---------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  employees    Employee[]
  clients      Client[]
  entries      WorkEntry[]
  apiKeys      ApiKey[]
  settings     Settings?
  invoices        Invoice[]
  aadeConnection  AadeConnection?
  vatSyncLogs     VatSyncLog[]
  categoryAudits  CategoryAuditEvent[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Machine-to-machine credential for the companion time-tracking app.
// Only the sha256 hash of the token is stored; the plaintext is shown once at creation.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hashedKey  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// --- Productivity domain --------------------------------------------------

// A worker whose time is tracked. costPerHour is derived: monthlyCost / hoursPerMonth.
model Employee {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  monthlyCost Float       @default(0)
  notes       String?
  active      Boolean     @default(true)
  // Contracted working hours per month. Falls back to the account-wide
  // Settings value when unset; drives availability and cost per hour.
  contractHoursPerMonth     Float?
  // Management targets (all optional; metrics hide when unset).
  targetUtilizationPct      Float? // billable utilization target, 0–100
  targetMonthlyHours        Float?
  targetMonthlyContribution Float? // €/month
  // Personal link to the entry terminal (/t/<token>). Null until the owner
  // creates one; revoking sets it back to null and the URL dies immediately.
  // Stored in the clear on purpose: the owner has to be able to re-copy the
  // link. It grants nothing but "log time as this one employee".
  accessToken   String?   @unique
  accessTokenAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  entries     WorkEntry[]

  @@unique([userId, name])
  @@index([userId])
}

// A client the work is billed against. Revenue is configured; cost/profit are computed.
model Client {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  billable       Boolean     @default(true)
  monthlyRevenue Float       @default(0)
  // Hours budgeted per month for this client (planned-vs-actual, overrun alerts).
  plannedMonthlyHours Float?
  notes          String?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  entries        WorkEntry[]

  @@unique([userId, name])
  @@index([userId])
}

// One logged unit of work. Fed by the separate time-tracking app or entered by the manager.
// minutes is the source of truth; hours = minutes / 60.
model WorkEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  workType   String?
  minutes    Int
  notes      String?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, externalId])
  @@index([date])
  @@index([userId])
  @@index([employeeId])
  @@index([clientId])
}

// --- VAT / myDATA domain ---------------------------------------------------

// Per-tenant AADE myDATA credentials. Both secrets are stored AES-256-GCM
// encrypted (see lib/crypto.ts); plaintext never leaves the server.
model AadeConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment           String   @default("sandbox") // sandbox | production
  entityVatNumber       String?
  aadeUserIdCipher      String
  subscriptionKeyCipher String
  lastSyncedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// One invoice/document, either fetched from myDATA or entered manually.
// All monetary values are integer cents; vatRateBps is basis points (2400 = 24%).
model Invoice {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  aadeMark               String? // myDATA registration number (ΜΑΡΚ)
  aadeUid                String?
  invoiceType            String? // myDATA document type, e.g. "1.1", "2.1", "13.1"
  documentNumber         String? // series + number
  direction              String // income | expense

  issuerVatNumber        String?
  issuerName             String?
  counterpartyVatNumber  String?
  counterpartyName       String?

  issueDate              DateTime
  transmissionDate       DateTime?

  netCents               Int
  vatCents               Int
  grossCents             Int
  currency               String    @default("EUR")
  vatRateBps             Int?
  vatCategoryCode        Int? // myDATA vatCategory 1..10

  aadeClassificationCategory String?
  aadeClassificationType     String?

  // standard | exempt | zero_rated | reverse_charge | intra_community | out_of_scope
  vatTreatment           String    @default("standard")
  vatDeductible          Boolean   @default(true)
  deductiblePct          Int       @default(100) // partial deductibility, 0..100
  nonDeductibleReason    String?

  predictedCategory      String?
  categoryConfidence     Float?
  categoryExplanation    String?
  manualCategory         String? // accountant override — always wins

  needsReview            Boolean   @default(false)
  reviewReason           String?

  description            String?
  source                 String    @default("aade") // aade | manual | import
  rawPayload             String? // raw AADE record (JSON) kept for audit/debug
  syncedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  audits                 CategoryAuditEvent[]

  @@unique([userId, aadeMark]) // duplicate-sync guard (NULL marks allowed for manual docs)
  @@index([userId, issueDate])
  @@index([userId, direction])
  @@index([userId, needsReview])
}

// One myDATA sync attempt. errorCode is a sanitized machine code — never raw
// upstream messages, which could echo credentials or PII.
model VatSyncLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment String
  status      String    @default("running") // running | success | error
  fetched     Int       @default(0)
  imported    Int       @default(0)
  duplicates  Int       @default(0)
  errorCode   String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([userId, startedAt])
}

// Audit trail for manual category/deductibility overrides.
model CategoryAuditEvent {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  previousCategory    String?
  newCategory         String?
  previousDeductible  Boolean?
  newDeductible       Boolean?
  note                String?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([invoiceId])
}

// Single-row global config. Always id = 1. hoursPerMonth = hoursPerDay * daysPerMonth.
model Settings {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hoursPerDay     Float    @default(8)
  daysPerMonth    Float    @default(22)
  includeOverhead Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}
