# Copy to .env.local and fill in. Never commit real values.

# --- Database (Turso / libSQL). Local dev falls back to file:./dev.db ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- S3 (invoice uploads) ---
AWS_REGION=
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- VAT / AADE myDATA integration ---
# Key used to AES-256-GCM encrypt per-user AADE credentials at rest.
# Any long random string (>= 32 chars recommended). Rotating it invalidates stored credentials.
AXION_ENCRYPTION_KEY=

# Optional single-tenant fallback credentials (used only when a user has not
# stored their own connection). Server-side only — never exposed to the browser.
AADE_USER_ID=
AADE_SUBSCRIPTION_KEY=
# test | production | mock   (mock = local demo data, no AADE calls)
AADE_ENV=test

# Optional base URL overrides (defaults: mydataapidev.aade.gr / mydatapi.aade.gr/myDATA/)
# AADE_SANDBOX_BASE_URL=
# AADE_PRODUCTION_BASE_URL=

# --- App URL + transactional email (password reset) ---
# Public base URL used in emailed links. Required in production (links are
# never built from the request's Host header). Falls back to the Vercel
# production domain, and to http://localhost:3000 in development.
APP_URL=
# Resend (https://resend.com) API key and a verified sender, e.g. "Axion <no-reply@axion.gr>".
# Without them, development prints emails to the server console; production sends nothing.
RESEND_API_KEY=
EMAIL_FROM=

# --- Admin console (/el/admin) ---
# Comma-separated emails of accounts that may open the platform admin console.
# Only list addresses that already have an account (signup has no email
# verification yet, so an unregistered address could be claimed by anyone).
ADMIN_EMAILS=
