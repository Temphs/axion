# Copy to .env.local or .env and adjust as needed.

# Local development database path used by Prisma when Turso is not configured.
DATABASE_URL="file:./dev.db"

# Turso / libSQL connection string for server-side database access.
TURSO_DATABASE_URL=

# Turso authentication token for the database connection.
TURSO_AUTH_TOKEN=

# AWS region for future S3 and Lambda integrations.
AWS_REGION=eu-central-1

# S3 bucket name for future file storage.
S3_BUCKET_NAME=

# AWS access key used only on the server.
AWS_ACCESS_KEY_ID=

# AWS secret access key used only on the server.
AWS_SECRET_ACCESS_KEY=
