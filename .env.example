# Copy to .env and adjust as needed.

# Local development: a SQLite file resolved relative to the project root.
DATABASE_URL="file:./dev.db"

# Production (Vercel) / hosted Turso database. When TURSO_DATABASE_URL is set it
# takes precedence over DATABASE_URL. Get these from `turso db show` / `turso db tokens create`.
# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="<token>"
